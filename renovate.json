{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "rebaseWhen": "conflicted",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/roles/.+/defaults/main\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+\\w+_version:\\s*[\"']?(?<currentValue>[^@\"'\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"
      ],
      "datasourceTemplate": "{{#if datasource}}{{datasource}}{{else}}docker{{/if}}",
      "versioningTemplate": "{{#if versioning}}{{versioning}}{{else}}docker{{/if}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/roles/.+/defaults/main\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate-upstream: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n# renovate:[^\\n]*\\n\\w+_version:\\s*[\"']?(?<currentValue>[^@\"'\\s]+)"
      ],
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/roles/.+/defaults/main\\.ya?ml$/",
        "/(^|/)(group_vars|host_vars)/.+\\.ya?ml$/"
      ],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "aur_packages:\\s*\\n(?:[ \\t]+[^\\n]*\\n?)+",
        "name:\\s*[\"']?(?<depName>[^\\s\"']+)[\"']?\\s*\\n\\s*commit:\\s*[\"']?(?<currentDigest>[a-f0-9]{40})"
      ],
      "currentValueTemplate": "master",
      "packageNameTemplate": "https://aur.archlinux.org/{{depName}}.git",
      "datasourceTemplate": "git-refs"
    }
  ],
  "customDatasources": {
    "paperless-compose": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/paperless-ngx/paperless-ngx/main/docker/compose/docker-compose.postgres-tika.yml",
      "format": "yaml",
      "transformTemplates": [
        "{\"releases\": [{\"version\": $split(services.{{packageName}}.image, \":\")[-1]}]}"
      ]
    }
  },
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/gotenberg/gotenberg", "docker.io/apache/tika"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "enabled": false
    },
    {
      "matchDatasources": ["git-refs"],
      "matchPackageNames": ["/^https://aur\\.archlinux\\.org//"],
      "matchUpdateTypes": ["digest"],
      "changelogUrl": "https://aur.archlinux.org/cgit/aur.git/diff/?h={{depName}}&id={{newDigest}}&id2={{currentDigest}}"
    }
  ]
}
